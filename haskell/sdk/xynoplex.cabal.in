cabal-version: 3.0
name: xynoplex
version: @VERSION@
synopsis: Typed Xynoplex SDK for Haskell
description: Protocol-derived models for the Xynoplex knowledge platform.
license: Apache-2.0
license-file: LICENSE
category: Network
author: Xynoplex
maintainer: Xynoplex contributors
build-type: Simple
extra-source-files: codegen/annotation-adapters.json, test/store-owner-policy.py, test/store-owner-policy.ps1, test/store-lock-peer.py, generated/Xynoplex/Internal/Generated/xynoplex_store_policy.h, test/fixtures/*.pem, codegen/session-adapters.json, xynoplex.cabal.in, README.md, run.sh, api.py, public-api.inputs.json, public-api.json, test/refusals.py, test/refusals/*.hs, test/http-peer.py, conformance/README.md, conformance/launch.sh

common settings
  default-language: GHC2021
  ghc-options: -Wall -Wincomplete-patterns -Wincomplete-record-updates
  build-depends:
    base >=4.20 && <4.21,
    aeson >=2.3 && <2.4,
    async >=2.2 && <2.3,
    bytestring >=0.12 && <0.13,
    base64-bytestring >=1.2 && <1.3,
    containers >=0.7 && <0.8,
    regex-tdfa >=1.3 && <1.4,
    scientific >=0.3 && <0.4,
    stm >=2.5 && <2.6,
    streaming >=0.2 && <0.3,
    text >=2.1 && <2.2,
    vector >=0.13 && <0.14,
    QuickCheck >=2.19 && <2.20

common context-propagation
  build-depends: hs-opentelemetry-api >=1.0 && <1.1, http-client >=0.7 && <0.8, http-types >=0.12 && <0.13, case-insensitive >=1.2 && <1.3, network-uri >=2.6 && <2.7, uuid-types >=1.0 && <1.1, unordered-containers >=0.2 && <0.3

common crypto
  build-depends: crypton >=2.2 && <2.3, ram >=0.22 && <0.23, crypton-pem >=0.3 && <0.4, crypton-x509 >=1.10 && <1.11, crypton-x509-store >=1.10 && <1.11

library
  default-language: GHC2021
  build-depends: base >=4.20 && <4.21, xynoplex:internal
  reexported-modules: Xynoplex.Types, Xynoplex.Types.Presence, Xynoplex.Channels, Xynoplex.Running, Xynoplex.ErrorCodes, Xynoplex.Timing, Xynoplex.Timing.Settings, Xynoplex.Retry, Xynoplex.Discovery, Xynoplex.Discovery.Reasons, Xynoplex.Transport, Xynoplex.Transport.Facts, Xynoplex.StateValue, Xynoplex.Errors, Xynoplex.EventBus, Xynoplex.Bus, Xynoplex.Http, Xynoplex.Http.Discovery, Xynoplex.Content, Xynoplex.Gateway, Xynoplex.Frame, Xynoplex.Auth, Xynoplex.System, Xynoplex.Client, Xynoplex.JobFilter, Xynoplex.Claims, Xynoplex.HostName, Xynoplex.Worker, Xynoplex.Worker.Types, Xynoplex.Bind, Xynoplex.Beckon, Xynoplex.Job, Xynoplex.Cache, Xynoplex.Resources, Xynoplex.MediaTypes, Xynoplex.Browse, Xynoplex.Gather, Xynoplex.Match, Xynoplex.Delegation, Xynoplex.Mark, Xynoplex.Yield, Xynoplex.Tokens, Xynoplex.SessionStorage, Xynoplex.Session, Xynoplex.Issuer, Xynoplex.Registry.Stored, Xynoplex.ClientAssertion, Xynoplex.ServiceToken, Xynoplex.SignIn, Xynoplex.SignInStore, Xynoplex.Annotations, Xynoplex.Identity, Xynoplex.StoragePersister, Xynoplex.State.SessionSignals, Xynoplex.Registry.Identity, Xynoplex.Registry.Factory, Xynoplex.Registry.Resources, Xynoplex.Registry, Xynoplex.State.HoverDwell, Xynoplex.State.Search, Xynoplex.State.Beckon, Xynoplex.State.Match, Xynoplex.State.Gather, Xynoplex.State.Mark, Xynoplex.State.Yield, Xynoplex.Testing, Xynoplex.Testing.Client, Xynoplex.Testing.Transport, Xynoplex.Testing.Storage, Xynoplex.Testing.Sessions, Xynoplex.Testing.Liveness

library internal
  import: settings, context-propagation, crypto
  build-depends: directory >=1.3 && <1.4, filepath >=1.5 && <1.6, time >=1.12 && <1.13
  visibility: private
  hs-source-dirs: src, internal, generated
  c-sources: internal/Xynoplex/Internal/NativeStore.c
  include-dirs: generated/Xynoplex/Internal/Generated
  cc-options: -Wall -Wextra -Werror
  if os(windows)
    extra-libraries: advapi32, bcrypt
  exposed-modules:
    Xynoplex.Types
    Xynoplex.Types.Presence
    Xynoplex.Channels
    Xynoplex.Running
    Xynoplex.ErrorCodes
    Xynoplex.Timing
    Xynoplex.Timing.Settings
    Xynoplex.Retry
    Xynoplex.Discovery
    Xynoplex.Discovery.Reasons
    Xynoplex.Transport
    Xynoplex.Transport.Facts
    Xynoplex.StateValue
    Xynoplex.Errors
    Xynoplex.EventBus
    Xynoplex.Bus
    Xynoplex.Internal.Schema
    Xynoplex.Internal.Required
    Xynoplex.Internal.Cache
    Xynoplex.Internal.Queries
    Xynoplex.Internal.Delegation
    Xynoplex.Internal.DelegatedVerbs
    Xynoplex.Internal.Mark
    Xynoplex.Internal.Yield
    Xynoplex.Internal.Generated.OperationReports
    Xynoplex.Internal.Browse
    Xynoplex.Internal.Gather
    Xynoplex.Internal.Match
    Xynoplex.Internal.Refresh
    Xynoplex.Internal.Text
    Xynoplex.Internal.Utf8
    Xynoplex.Internal.StreamFrame
    Xynoplex.Internal.Broadcast
    Xynoplex.Internal.Sse
    Xynoplex.Internal.Running
    Xynoplex.Internal.Delivery
    Xynoplex.Internal.StateValue
    Xynoplex.Internal.Transport
    Xynoplex.Registry
    Xynoplex.Registry.Resources
    Xynoplex.Registry.Factory
    Xynoplex.Internal.Generated.SessionFactoryOptions
    Xynoplex.Registry.Identity
    Xynoplex.State.SessionSignals
    Xynoplex.State.Beckon
    Xynoplex.State.Match
    Xynoplex.State.Gather
    Xynoplex.State.Mark
    Xynoplex.State.Yield
    Xynoplex.Testing
    Xynoplex.Testing.Client
    Xynoplex.Testing.Transport
    Xynoplex.Testing.Storage
    Xynoplex.Testing.Sessions
    Xynoplex.Testing.Liveness
    Xynoplex.Internal.Generated.Testing
    Xynoplex.Internal.Generated.PendingAnnotation
    Xynoplex.Internal.Generated.MarkMotivation
    Xynoplex.State.HoverDwell
    Xynoplex.State.Search
    Xynoplex.Internal.Generated.SearchState
    Xynoplex.Internal.StateTasks
    Xynoplex.StoragePersister
    Xynoplex.Internal.Coupled
    Xynoplex.Internal.Persistence
    Xynoplex.Internal.Kept
    Xynoplex.Internal.Generated.CachePersistence
    Xynoplex.Internal.Generated.Stored
    Xynoplex.Identity
    Xynoplex.Internal.Generated.Principals
    Xynoplex.Internal.Generated.BusLog
    Xynoplex.Internal.BusLog
    Xynoplex.Internal.Generated.UnicodeCase
    Xynoplex.Annotations
    Xynoplex.Internal.Annotations.Id
    Xynoplex.Internal.Annotations.Pdf
    Xynoplex.Internal.Annotations.Spans
    Xynoplex.Http
    Xynoplex.Http.Discovery
    Xynoplex.Content
    Xynoplex.Gateway
    Xynoplex.Frame
    Xynoplex.Auth
    Xynoplex.System
    Xynoplex.Client
    Xynoplex.JobFilter
    Xynoplex.Claims
    Xynoplex.HostName
    Xynoplex.Worker
    Xynoplex.Worker.Types
    Xynoplex.Bind
    Xynoplex.Beckon
    Xynoplex.Job
    Xynoplex.Cache
    Xynoplex.Resources
    Xynoplex.MediaTypes
    Xynoplex.Browse
    Xynoplex.Gather
    Xynoplex.Match
    Xynoplex.Delegation
    Xynoplex.Mark
    Xynoplex.Yield
    Xynoplex.Tokens
    Xynoplex.SessionStorage
    Xynoplex.Session
    Xynoplex.Issuer
    Xynoplex.ClientAssertion
    Xynoplex.ServiceToken
    Xynoplex.SignIn
    Xynoplex.SignInStore
    Xynoplex.Registry.Stored
    Xynoplex.Internal.Http
    Xynoplex.Internal.HttpActor
    Xynoplex.Internal.HttpContent
    Xynoplex.Internal.Lifetime
    Xynoplex.Http.Routes
    Xynoplex.Internal.Generated.Text
    Xynoplex.Internal.Generated.CacheRefresh
    Xynoplex.Internal.Generated.Required
    Xynoplex.Internal.Generated.Schemas
  other-modules:
    Paths_xynoplex
    Xynoplex.Internal.Telemetry
    Xynoplex.Internal.Codec
    Xynoplex.Internal.Bus
    Xynoplex.Internal.Local
    Xynoplex.Internal.RetryPolicy
    Xynoplex.Internal.Generated.OperationFailure
    Xynoplex.Internal.Generated.OAuth
    Xynoplex.Internal.Generated.SignInStore
    Xynoplex.Internal.NativeStore
    Xynoplex.Internal.SignIn
    Xynoplex.Internal.Stored
    Xynoplex.Internal.Generated.ClientAssertion
    Xynoplex.Internal.Generated.ServiceProof
    Xynoplex.Internal.Issuer
    Xynoplex.Internal.Digest
    Xynoplex.Internal.Generated.WorkerChannels
@MODEL_MODULES@
  autogen-modules: Paths_xynoplex

executable xynoplex-codegen
  import: settings
  main-is: Main.hs
  hs-source-dirs: codegen, internal
  other-modules: Xynoplex.Internal.Schema, Facts, TransportFacts, HttpFacts, WorkerFacts, WorkerTypes
  ghc-options: -threaded
  build-depends: mtl >=2.3 && <2.4, directory >=1.3 && <1.4, filepath >=1.5 && <1.6

test-suite schema-cases
  import: settings, context-propagation, crypto
  build-tool-depends: hpc-codecov:hpc-codecov ==0.6.4.1
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  other-modules: Xynoplex.Internal.Generated.RoundTrip, Xynoplex.Internal.Generated.ChannelRoundTrip, Xynoplex.Internal.Generated.ErrorRoundTrip, Xynoplex.Internal.Generated.TimingValues, Xynoplex.Internal.Generated.DiscoveryReasonRoundTrip, Runtime, Discovery, BusCases, SchemaCases, HttpCases, HttpDiscoveryCases, AnnotationCases, IdentityCases, BusLogCases, PersistenceCases, PersistedCases, GatewayStage, CacheDocumentCases, StateUnitCases, FlowCases, ActorCases, TestingCases, RegistryCases, OpenResourceCases, RegistryErrorsCases, RegistryRuntimeCases, LifetimeCases, WorkerCases, GatewayCases, HeldCases, SurfaceCases, CacheCases, ControlledTime, ClockCases, ResourceCases, FrameCases, RefreshCases, TextCases, DelegationCases, TokenStorageCases, SessionCases, IssuerCases, ClientAssertionCases, SignInStoreCases, TestProcess
  ghc-options: -threaded
  build-depends: xynoplex:internal, process >=1.6 && <1.7, directory >=1.3 && <1.4, filepath >=1.5 && <1.6, time >=1.12 && <1.13

executable xynoplex-haskell-wire-driver
  import: settings, context-propagation
  main-is: Main.hs
  other-modules: DriverProtocol
  hs-source-dirs: conformance
  ghc-options: -threaded
  build-depends: xynoplex, http-client >=0.7 && <0.8, uuid >=1.3 && <1.4, uuid-types >=1.0 && <1.1, random >=1.3 && <1.4, time >=1.12 && <1.13, hs-opentelemetry-sdk >=1.0 && <1.1

executable xynoplex-haskell-live-driver
  import: settings, context-propagation
  main-is: LiveMain.hs
  other-modules: DriverProtocol, LiveQueries
  hs-source-dirs: conformance
  ghc-options: -threaded
  build-depends: xynoplex, http-client >=0.7 && <0.8, uuid >=1.3 && <1.4, uuid-types >=1.0 && <1.1, random >=1.3 && <1.4, time >=1.12 && <1.13
