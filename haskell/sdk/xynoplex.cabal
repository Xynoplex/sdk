cabal-version: 3.0
name: xynoplex
version: 0.7.3
synopsis: Typed Xynoplex SDK for Haskell
description: Protocol-derived models for the Xynoplex knowledge platform.
license: Apache-2.0
license-file: LICENSE
category: Network
author: Xynoplex
maintainer: Xynoplex contributors
build-type: Simple
extra-source-files: codegen/annotation-adapters.json, test/store-owner-policy.py, test/store-owner-policy.ps1, test/store-lock-peer.py, generated/Xynoplex/Internal/Generated/xynoplex_store_policy.h, test/fixtures/*.pem, codegen/session-adapters.json, xynoplex.cabal.in, README.md, run.sh, api.py, public-api.inputs.json, public-api.json, test/refusals.py, test/refusals/*.hs, test/http-peer.py, conformance/README.md, conformance/launch.sh

common settings
  default-language: GHC2021
  ghc-options: -Wall -Wincomplete-patterns -Wincomplete-record-updates
  build-depends:
    base >=4.20 && <4.21,
    aeson >=2.3 && <2.4,
    async >=2.2 && <2.3,
    bytestring >=0.12 && <0.13,
    base64-bytestring >=1.2 && <1.3,
    containers >=0.7 && <0.8,
    regex-tdfa >=1.3 && <1.4,
    scientific >=0.3 && <0.4,
    stm >=2.5 && <2.6,
    streaming >=0.2 && <0.3,
    text >=2.1 && <2.2,
    vector >=0.13 && <0.14,
    QuickCheck >=2.19 && <2.20

common context-propagation
  build-depends: hs-opentelemetry-api >=1.0 && <1.1, http-client >=0.7 && <0.8, http-types >=0.12 && <0.13, case-insensitive >=1.2 && <1.3, network-uri >=2.6 && <2.7, uuid-types >=1.0 && <1.1, unordered-containers >=0.2 && <0.3

common crypto
  build-depends: crypton >=2.2 && <2.3, ram >=0.22 && <0.23, crypton-pem >=0.3 && <0.4, crypton-x509 >=1.10 && <1.11, crypton-x509-store >=1.10 && <1.11

library
  default-language: GHC2021
  build-depends: base >=4.20 && <4.21, xynoplex:internal
  reexported-modules: Xynoplex.Types, Xynoplex.Types.Presence, Xynoplex.Channels, Xynoplex.Running, Xynoplex.ErrorCodes, Xynoplex.Timing, Xynoplex.Timing.Settings, Xynoplex.Retry, Xynoplex.Discovery, Xynoplex.Discovery.Reasons, Xynoplex.Transport, Xynoplex.Transport.Facts, Xynoplex.StateValue, Xynoplex.Errors, Xynoplex.EventBus, Xynoplex.Bus, Xynoplex.Http, Xynoplex.Http.Discovery, Xynoplex.Content, Xynoplex.Gateway, Xynoplex.Frame, Xynoplex.Auth, Xynoplex.System, Xynoplex.Client, Xynoplex.JobFilter, Xynoplex.Claims, Xynoplex.HostName, Xynoplex.Worker, Xynoplex.Worker.Types, Xynoplex.Bind, Xynoplex.Beckon, Xynoplex.Job, Xynoplex.Cache, Xynoplex.Resources, Xynoplex.MediaTypes, Xynoplex.Browse, Xynoplex.Gather, Xynoplex.Match, Xynoplex.Delegation, Xynoplex.Mark, Xynoplex.Yield, Xynoplex.Tokens, Xynoplex.SessionStorage, Xynoplex.Session, Xynoplex.Issuer, Xynoplex.Registry.Stored, Xynoplex.ClientAssertion, Xynoplex.ServiceToken, Xynoplex.SignIn, Xynoplex.SignInStore, Xynoplex.Annotations, Xynoplex.Identity, Xynoplex.StoragePersister, Xynoplex.State.SessionSignals, Xynoplex.Registry.Identity, Xynoplex.Registry.Factory, Xynoplex.Registry.Resources, Xynoplex.Registry, Xynoplex.State.HoverDwell, Xynoplex.State.Search, Xynoplex.State.Beckon, Xynoplex.State.Match, Xynoplex.State.Gather, Xynoplex.State.Mark, Xynoplex.State.Yield, Xynoplex.Testing, Xynoplex.Testing.Client, Xynoplex.Testing.Transport, Xynoplex.Testing.Storage, Xynoplex.Testing.Sessions, Xynoplex.Testing.Liveness

library internal
  import: settings, context-propagation, crypto
  build-depends: directory >=1.3 && <1.4, filepath >=1.5 && <1.6, time >=1.12 && <1.13
  visibility: private
  hs-source-dirs: src, internal, generated
  c-sources: internal/Xynoplex/Internal/NativeStore.c
  include-dirs: generated/Xynoplex/Internal/Generated
  cc-options: -Wall -Wextra -Werror
