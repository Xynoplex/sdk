{
  "name": "@xynolog/core",
  "version": "1.2611.0",
  "description": "Core types and domain logic for Xynolog - Resource, Annotation, and Graph models",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./testing/axioms": {
      "types": "./dist/testing/axioms.d.ts",
      "import": "./dist/testing/axioms.js",
      "default": "./dist/testing/axioms.js"
    },
    "./testing/issuer": {
      "types": "./dist/testing/issuer.d.ts",
      "import": "./dist/testing/issuer.js",
      "default": "./dist/testing/issuer.js"
    },
    "./openapi": {
      "types": "./dist/openapi.d.ts",
      "import": "./dist/openapi.js",
      "default": "./dist/openapi.js"
    }
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xynolog/sdk.git",
    "directory": "typescript/core"
  },
  "scripts": {
    "bundle-spec": "test -f ../../protocol/specs/openapi.json",
    "copy-spec": "cp ../../protocol/specs/openapi.json openapi.json",
    "generate:openapi": "npm run bundle-spec && npm run copy-spec && openapi-typescript openapi.json -o src/types.ts && node ../scripts/generators/generate-identifiers.mjs",
    "prebuild": "npm run generate:openapi && npm run generate:validators && npm run generate:limits && npm run generate:locales && npm run generate:job-storage",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && tsup && tsc -p tsconfig.build.json && rollup -c rollup.dts.config.mjs && rm -rf dist-types",
    "watch": "tsup --watch",
    "clean": "rm -rf dist *.tsbuildinfo src/types.ts src/generated openapi.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate:validators": "node ../scripts/generators/generate-validators.mjs",
    "generate:limits": "node ../scripts/generators/generate-limits.mjs",
    "generate:locales": "node ../scripts/generators/generate-locales.mjs",
    "generate:job-storage": "node ../scripts/generators/generate-job-storage.mjs"
  },
  "keywords": [
    "types",
    "domain",
    "resource",
    "annotation",
    "graph",
    "xynolog"
  ],
  "author": "Xynolog Team",
  "sideEffects": false,
  "license": "Apache-2.0",
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "fast-check": "^4.10.0",
    "openapi-typescript": "^7.10.1",
    "rollup": "^4.67.5",
    "rollup-plugin-dts": "^6.4.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jose": "^6.2.15",
    "rxjs": "^7.8.1"
  },
  "peerDependencies": {
    "fast-check": "^4.8.0"
  },
  "peerDependenciesMeta": {
    "fast-check": {
      "optional": true
    }
  }
}
