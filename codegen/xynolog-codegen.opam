# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "Xynolog's generator: Protocol's specs, read strictly, into every SDK's code"
description:
  "Reads the pinned Protocol's specs into a model that refuses what it does not know."
maintainer: ["Xynolog maintainers"]
authors: ["Xynolog"]
license: "Apache-2.0"
homepage: "https://github.com/xynolog/sdk"
bug-reports: "https://github.com/xynolog/sdk/issues"
depends: [
  "dune" {>= "3.24"}
  "ocaml" {= "5.5.2"}
  "yojson" {>= "3.0.0"}
  "alcotest" {with-test}
  "ocamlformat" {with-test & = "0.29.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/xynolog/sdk.git"
x-maintenance-intent: ["(latest)"]
